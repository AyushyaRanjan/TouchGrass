# Copy to .env and fill in values.
# Required: a long random token the mobile app must send as a Bearer token.
API_TOKEN=redbluegreen

# Local Ollama server.
OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:3b

# IANA timezone used for task dates and streaks.
TIMEZONE=Europe/London

# If true, log screen-or-print suspicion (never rejects in V1).
BLIND_PASS=false
